{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// svelte-check resolves `.svelte` imports itself and only understands tsconfig `paths`, not
		// package.json `imports`. Mirror the `#lib` subpaths here so components keep their prop types.
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
