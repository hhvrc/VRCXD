{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate": "buf generate && paraglide-js compile --project ./project.inlang --silent",
		"dev": "pnpm run generate && vite dev",
		"build": "pnpm run generate && vite build && node scripts/generate-third-party-licenses.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.75.0",
		"@bufbuild/protoc-gen-es": "^2.17.0",
		"@inlang/paraglide-js": "^3.2.1",
		"@inlang/plugin-message-format": "^4.6.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.70.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"@typescript/native": "npm:typescript@~7.0.2",
		"bits-ui": "^2.20.6",
		"paneforge": "^1.0.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-jp": "^5.3.1",
		"@fontsource-variable/noto-sans-kr": "^5.3.1",
		"@fontsource-variable/noto-sans-sc": "^5.3.1",
		"@fontsource-variable/noto-sans-tc": "^5.3.1",
		"@sentry/browser": "10.68.0",
		"@sigma/node-border": "^4.0.0",
		"clsx": "^2.1.1",
		"echarts": "^6.1.0",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"graphology-layout-forceatlas2": "^0.10.1",
		"graphology-layout-noverlap": "^0.4.2",
		"qrcode": "^1.5.4",
		"remixicon": "^4.9.1",
		"sigma": "^4.0.4",
		"tailwind-merge": "^3.7.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
