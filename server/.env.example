# Copy to .env next to docker-compose.yml. See the README's Deploy section.
PG_PASS=change-me
VRCX_TOKEN=change-me-to-at-least-16-characters

# Optional
#VRCX_TAG=latest
#VRCX_BIND=192.168.1.10
#VRCX_PORT=5280
#VRCX_HTTPS_PORT=5443
#VRCX_SITE=vrcx.example.com
#BACKUP_DIR=/volume2/backups/vrcx
#BACKUP_KEEP_DAYS=7
# Sentry DSN for the web client's opt-in error reports; unset turns error reporting off
#ERROR_REPORTING_DSN=
