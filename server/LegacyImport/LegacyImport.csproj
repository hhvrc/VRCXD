<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Carries an original VRCX database (VRCX.sqlite3) into this server's Postgres from the command
    line, talking to Postgres directly. The importer itself is Common/Features/LegacyImport, which
    the server's Settings page runs on an uploaded file too; see README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
</Project>
