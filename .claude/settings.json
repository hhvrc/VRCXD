{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git check-attr *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch vrcx)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef migrations has-pending-model-changes *)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run check)",
      "Bash(pnpm run generate)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(cargo fmt --check)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(python -I server/Testing/upstream-coverage.py *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)"
    ]
  }
}
